DD_API_BASE=https://dd-api-dev.anomalygames.ai

# Auth — pick ONE or combine. Find these in your browser's Network tab while
# logged into the dev build.
DD_AUTH_TOKEN=
DD_COOKIE=
# JSON object of additional headers, e.g. {"x-csrf-token":"abc"}
DD_EXTRA_HEADERS=

DISCORD_BOT_TOKEN=
DISCORD_APP_ID=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

WEB_BASE_URL=http://localhost:8000

# Discord bot persistence
DD_BOT_DB_PATH=./bot_state.db
# Generate with: python -m dd_agent.secrets
DD_BOT_SECRET_KEY=

# Hermes shadow observer (optional — set true to activate)
# Ollama local (no Docker): HERMES_BASE_URL=http://localhost:11434/v1
# Ollama via Docker:        set by docker-compose.yml automatically (http://ollama:11434/v1)
# Together AI:              HERMES_BASE_URL=https://api.together.xyz/v1  (needs HERMES_API_KEY)
HERMES_ENABLED=false
HERMES_BASE_URL=http://localhost:11434/v1
HERMES_MODEL=hermes3
